# Cloudflare Pages cache rules.
#
# Force index.html and the root path to revalidate on every load. The HTML
# carries the ?v=N query strings on every script/style tag, so as soon as
# index.html is fresh the browser will pull whichever sub-resources changed.
# Without this rule Cloudflare's default cache (and iOS PWA's aggressive
# offline cache) can serve a months-old index.html that points to long-stale
# JSX versions — that's why mobile saw an old YTD chart while desktop didn't.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Versioned static assets are safe to cache for a long time: the URL itself
# changes (?v=49 → ?v=50) whenever we ship new code, so a stale cache entry
# is simply unused rather than served instead of fresh content.
/*.jsx
  Cache-Control: public, max-age=31536000
/*.js
  Cache-Control: public, max-age=31536000
/*.css
  Cache-Control: public, max-age=31536000
