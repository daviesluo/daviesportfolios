# Supabase Edge Function environment variables.
# Set these in Supabase dashboard → Edge Functions → Settings → Secrets.
# The browser does NOT read this file — it only sees src/app/supabase_config.js
# (anon key + URL, both safe to ship).
#
# `SUPABASE_URL` and `SUPABASE_SERVICE_ROLE_KEY` are auto-injected by
# Supabase into every Edge Function's environment, so you only need to
# add the app-level secrets below.

# Long random string used to HMAC-sign auth tokens. Rotate to invalidate
# every existing session. Generate with:  openssl rand -hex 32
APP_AUTH_SECRET=replace-me-with-32-bytes-of-hex

# The two passwords gate the app. `?pwd=<APP_ADMIN_PWD>` grants edit
# rights; `?pwd=<APP_RO_PWD>` opens a read-only share view. (These exact
# names are what `supabase/functions/auth/index.ts` reads — keep them in
# sync; an `APP_ADMIN_PASSWORD`-style name leaves auth unconfigured.)
APP_ADMIN_PWD=admin-password
APP_RO_PWD=share-password

# Finnhub free-tier API key (https://finnhub.io/register, 60 calls /
# minute). Used by the `fundamentals` Edge Function for the 3-year-
# average P/E + P/S reference lines, and as the whole-row fallback for
# current pe/eps/ps when Yahoo's quoteSummary crumb handshake fails.
# (Yahoo quoteSummary is the primary source and needs no API key.)
# Without it the P/E / P/S YTD buttons still work but the 3Y AVG line
# is hidden and a Yahoo outage drops the chart.
FINNHUB_API_KEY=replace-me

# Alpha Vantage free-tier API key (https://www.alphavantage.co/support/#api-key,
# 25 requests / day). Used by the `fundamentals` Edge Function only
# for the four big US indices (^GSPC / ^NDX / ^RUT / ^SOX) via their
# ETF proxies (SPY / QQQ / IWM / SOXX). Backed by a 24 h server-side
# cache in the `index_fundamentals_cache` table so we burn at most
# 4 calls / day no matter how many clients hit the Edge Function.
# Without it the index P/E button still works via a hardcoded
# fallback (the printed values just won't auto-refresh).
ALPHAVANTAGE_API_KEY=replace-me

# Trading 212 API key. Generate in T212 → Settings → Account &
# Personal → API Settings. Read by `trading212` (every position the
# broker reports, its executed fills and its overnight quotes),
# `overnight-record` and `snapshot-record`. Without it `trading212`
# returns `source: 'disabled'` + empty holdings and the client
# silently no-ops (existing manual lots stay).
T212_API_KEY=replace-me

# Secret for T212's two-key accounts. When it is set the functions go
# straight to HTTP Basic Auth (T212_API_KEY as username, this as
# password) and keep the raw key only as a 401 fallback; leave it unset
# for a single-key account, which sends the raw key alone.
T212_API_SECRET=

# Optional second Trading 212 account (the ISA). T212 scopes its public
# API per account, so the ISA's holdings + overnight prices need their
# own key. When set, the `trading212` and `overnight-record` functions
# fetch both portfolios in parallel and merge them (invest is primary;
# an ISA fetch failure degrades to invest-only). `T212_ISA_API_SECRET`
# is the same optional two-key Basic-Auth fallback as T212_API_SECRET.
# Leave unset to run a single (invest-only) account.
T212_ISA_API_KEY=
T212_ISA_API_SECRET=

# Bearer secret the cron-called functions require: `overnight-record`,
# `snapshot-record` and `agents` (all deploy with --no-verify-jwt, so
# this is their auth gate). pg_cron reads the same value from Supabase
# Vault as `cron_secret` (migration 0021). Generate with:
# openssl rand -hex 32
CRON_SECRET=replace-me-with-32-bytes-of-hex

# Crypto agents (the `agents` Edge Function). All optional: without
# them a venue shows as not configured and nothing can trade live;
# paper rows run on public market data. Each name below is the one the
# code reads first; the spelling in brackets is also accepted.
# Revolut X API key id (Revolut_X_API_kEY)
REVOLUT_X_API_KEY=
# Revolut X Ed25519 private key, in any pasted shape
REVOLUT_X_PRIVATE_KEY=
# Kraken API key and its base64 secret, as issued
KRAKEN_PRO_API_KEY=
KRAKEN_PRO_PRIVATE_KEY=
# The Jev decision model through OpenRouter (openrouter_api_key)
OPENROUTER_API_KEY=
# Fallback: TypeSafe's own endpoint (typesafe_API_KEY)
TYPESAFE_API_KEY=
# Binance and Deribit, read by the probe only (permissions, fees, symbol
# rules; Deribit's auth scope and volatility index). Nothing trades there.
# Binance key and HMAC secret (Binance_API_KEY / Binance_SECRET_KEY)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
# Deribit client credentials (Deribit_CLIENT_ID / Deribit_CLIENT_SECRET)
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=
