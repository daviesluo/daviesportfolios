{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/*.test.{js,jsx}",
    "src/test_setup.js",
    "supabase/functions/*/index.ts",
    "supabase/functions/*/index.test.ts",
    "supabase/functions/agents/backtest.ts",
    "supabase/functions/agents/backtest_ideas.ts"
  ],
  "project": [
    "src/**/*.{js,jsx,ts}",
    "supabase/functions/**/*.ts"
  ],
  "ignoreUnresolved": [
    "./test_setup.js"
  ],
  "ignoreExportsUsedInFile": true
}
