{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.jsx",
    "src/*.test.{js,jsx}",
    "supabase/functions/*/index.ts",
    "supabase/functions/*/index.test.ts"
  ],
  "project": [
    "src/**/*.{js,jsx,ts}",
    "supabase/functions/**/*.ts"
  ],
  "ignore": [
    "src/test_setup.js",
    "src/utils.js"
  ],
  "ignoreDependencies": [
    "@testing-library/jest-dom",
    "@size-limit/preset-app"
  ]
}
